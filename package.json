{
  "name": "meu-financeiro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug && cd .. && mkdir -p artifacts && cp android/app/build/outputs/apk/debug/app-debug.apk artifacts/MeuFinanceiro-debug.apk"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
